# 复制本文件为 .env 后填写（不要把真实密钥提交到 Git）

# 抖音 PC 客户端路径（可选）。自动扫描找不到 Douyin.exe 时再填，例如：
# DOUYIN_EXE_PATH=D:\1\douyin\douyin.exe

# 对话里「今天」「现在」用的本地时区（默认 Asia/Shanghai）
# LOCAL_TIMEZONE=Asia/Shanghai

# 高德地图 Web 服务（天气、地理编码等）https://console.amap.com/
AMAP_KEY=

# 阿里云 DashScope / 百炼 — 对话、文生图、图片理解、划词翻译（全套能力）
DASHSCOPE_API_KEY=
# DASHSCOPE_CHAT_MODEL=qwen-turbo
# DASHSCOPE_VL_MODEL=qwen-vl-plus

# DeepSeek — OpenAI 兼容接口，可用于对话、翻译、知识库问答（不能替代百炼的生图/看图）
DEEPSEEK_API_KEY=
# DEEPSEEK_CHAT_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# 讯飞开放平台 — AppID / APIKey / APISecret（勿提交 Git）
# 若使用「超拟人语音合成」，请在超拟人产品页复制同款密钥填在此处。
# https://console.xfyun.cn/
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# 语音听写（流式版）与 TTS 共用上述密钥；需在控制台开通「语音听写（流式版）」服务，否则返回业务错误码。

# —— 超拟人语音合成（可选）：在控制台「超拟人」→ Websocket 服务接口里复制完整 wss 地址填入下面一行。
# 填写后 /api/tts 将走超拟人协议；不填则仍使用「在线语音合成」v2（tts-api.xfyun.cn）。
# XFYUN_SUPER_TTS_WS_URL=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/你的实例路径
# XFYUN_SUPER_TTS_SAMPLE_RATE=24000
# XFYUN_SUPER_TEXT_UTF8_MAX=62000
# 口语化：high / mid / low；若报错可试 XFYUN_SUPER_ORAL_DISABLE=1 去掉 oral 块
# XFYUN_SUPER_ORAL_LEVEL=mid
# 填写超拟人 URL 后，默认女声为文档「默认免费发音人」聆小璇，可用下面覆盖：
# XFYUN_DEFAULT_VCN_FEMALE=x5_lingxiaoxuan_flow
# 若控制台未给该 vcn「超拟人」授权（11200），后端会自动降级为在线合成 v2（如 xiaoyan）。
# 未配置超拟人 URL 时，对应经典音库示例：xiaoyan（见在线合成文档）
# XFYUN_TTS_SPEED=50
# XFYUN_TTS_VOLUME=50
# XFYUN_TTS_DISK_CACHE=1
# 默认 wav；多段拼接时不建议 mp3： XFYUN_TTS_AUDIO_FORMAT=mp3
# 仅在线合成 v2：采样率钳 8k/16k — XFYUN_TTS_SAMPLE_RATE=16000
